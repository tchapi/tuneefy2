# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
SYMFONY_DEPRECATIONS_HELPER=999999
PANTHER_APP_ENV=panther
PANTHER_ERROR_SCREENSHOT_DIR=./var/error-screenshots

LOG_ENABLED=0

TEST_API_CLIENT_ID=test_id
TEST_API_CLIENT_SECRET=test_secret
# The test web server (php -S / symfony server) is reached on 127.0.0.1:9999,
# so both the website and the API are routed on that host (see codeception.yml)
WEBSITE_HOST=127.0.0.1
API_HOST=127.0.0.1

# OAuth client created by `bin/test-env setup` (see also TEST_API_CLIENT_ID above)
API_BYPASS_CLIENT_IDENTIFIER=test_id
