<?xml version="1.0"?>
<psalm
    errorLevel="2"
    phpVersion="8.4"
    resolveFromConfigFile="true"
    strictBinaryOperands="false"
    runTaintAnalysis="false"
    findUnusedCode="false"
    findUnusedBaselineEntry="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
>
    <projectFiles>
        <directory name="src" />
        <ignoreFiles>
            <directory name="vendor" />
        </ignoreFiles>
    </projectFiles>

    <issueHandlers>
        <!-- Doctrine entities are proxied and the platform classes are meant to be extended -->
        <ClassMustBeFinal errorLevel="suppress" />
        <!-- Doctrine hydrates entities by reflection, without a constructor -->
        <MissingConstructor>
            <errorLevel type="suppress">
                <directory name="src/Entity" />
            </errorLevel>
        </MissingConstructor>
    </issueHandlers>

    <plugins>
        <!-- The first container file that exists is used. The test one is
             built by the container lint step in CI; locally, any dev or test
             boot of the app (bin/console, a request) writes it. -->
        <pluginClass class="Psalm\SymfonyPsalmPlugin\Plugin">
            <containerXml>var/cache/test/App_KernelTestDebugContainer.xml</containerXml>
            <containerXml>var/cache/dev/App_KernelDevDebugContainer.xml</containerXml>
        </pluginClass>
    </plugins>
</psalm>
